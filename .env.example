GM_BLINK_USERNAME=your-blink-email@example.com
# Used only by scripts/setup_blink.py (not sent to the Cloud Function)
GM_BLINK_PASSWORD=your-blink-password
GM_BLINK_CAMERA_NAME=Garage

# Analyzer: "gemini" (cloud AI, paid) or "tflite" (local ML model, free)
GM_ANALYZER=gemini

# Gemini settings (required only if GM_ANALYZER=gemini)
GM_GEMINI_API_KEY=your-gemini-api-key
GM_GEMINI_MODEL=gemini-2.5-flash
GM_GEMINI_COST_ALERT_THRESHOLD=3.0

GM_CONFIDENCE_THRESHOLD=0.7
GM_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GM_TELEGRAM_CHAT_ID=your-telegram-chat-id
GM_GCP_PROJECT_ID=your-gcp-project-id
GM_FIRESTORE_COLLECTION=garage_monitor
GM_TELEGRAM_WEBHOOK_SECRET=your-random-secret-string
# Read-only status endpoint for Home Assistant (?action=status, header Authorization: Bearer <token>). Empty = disabled
GM_STATUS_TOKEN=
# Token sent by Cloud Scheduler (X-Scheduler-Token): without it checks/report are refused. Empty = open (legacy)
GM_SCHEDULER_TOKEN=
